# Copy to .env (gitignored) and fill in real local values. These defaults match a fresh
# `inventory` role/database created against the shared local-infrastructure Postgres - see
# README.md "Getting started".

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=changeme

REDIS_HOST=localhost
REDIS_PORT=6379

SERVER_PORT=8081

# This application's own JWT signing secret (HMAC-SHA256) - see docs/security.md. The
# default in application.yml is fine for local dev only; every real deployment MUST set
# this to a long, random, secret value of its own.
JWT_SECRET=changeme
JWT_ISSUER=inventory-api
JWT_EXPIRATION_MINUTES=60

# Bootstraps the very first ADMIN user at startup, only if the users table is still empty
# - see AdminBootstrapRunner. Leave both blank in an environment where a user already
# exists; required to ever log in to a brand-new one.
APP_ADMIN_EMAIL=admin@example.com
APP_ADMIN_PASSWORD=changeme

# Fixed-window rate limit on POST /api/v1/auth/login (per caller IP) - see
# LoginRateLimitFilter. Optional, both have defaults.
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Fixed-window rate limit on every authenticated business endpoint, keyed by caller user
# id - see ApiRateLimitFilter. Optional, both have defaults.
RATE_LIMIT_API_WIDE_MAX_REQUESTS=300
RATE_LIMIT_API_WIDE_WINDOW_SECONDS=60

# Comma-separated list of frontend origins allowed cross-origin, e.g.
# https://app.example.com,https://admin.example.com. Empty by default - CORS is wired
# into SecurityConfig but permits nothing until this is set.
CORS_ALLOWED_ORIGINS=

# Webhook outbox dispatcher - see docs/specs/14-webhooks/requirements.md. All optional,
# all have defaults.
WEBHOOKS_DISPATCH_INTERVAL_MS=15000
WEBHOOKS_DISPATCH_BATCH_SIZE=50
WEBHOOKS_DELIVERY_TIMEOUT_MS=5000
WEBHOOKS_MAX_ATTEMPTS=10
